# Telegram sign-in for registration. The token signs the payload the widget
# hands the browser, and the server re-derives that signature before it will
# create an account, so this value is the whole basis for trusting an identity.
# It is never sent to the browser; only TELEGRAM_BOT_USERNAME is.
#
# Both keys come from @BotFather. Keep this file out of git.
#
# TELEGRAM_BOT_TOKEN=1234567890:replace-with-the-real-token
# TELEGRAM_BOT_USERNAME=your_bot_without_the_at_sign

# Order notifications. The chat id is where new orders are announced, together
# with a button that deletes a test order again. With no chat id the site just
# does not send notifications -- orders are still placed normally.
#
# TELEGRAM_ORDER_CHAT_ID=123456789

# Secret header Telegram sends with every webhook request. It is the only thing
# that tells an incoming callback apart from an impostor, so the webhook refuses
# every request while this is empty. Any long random string; set the same value
# on Telegram's side when calling setWebhook:
#   https://api.telegram.org/bot<token>/setWebhook?url=<public url>&secret_token=<this value>
#
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string

# Who is allowed to press "delete a test order". Defaults to the notification
# chat above; add a manager's chat id if a second person should be able to.
#
# TELEGRAM_ADMIN_CHAT_ID=123456789
# TELEGRAM_MANAGER_CHAT_ID=123456789
